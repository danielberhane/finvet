# FinVet configuration — copy to .env and fill in.
# Only DEEPSEEK_API_KEY, TAVILY_API_KEY and POSTGRES_PASSWORD are required.

# --- LLM (claim parsing, agent reasoning, verdicts) ---
DEEPSEEK_API_KEY=

# --- Embeddings for RAG + claim memory ---
# Served locally by Ollama — no API key, no per-call billing.
#   ollama pull nomic-embed-text
OLLAMA_URL=http://localhost:11434


# --- Data sources ---
FINNHUB_API_KEY=
TAVILY_API_KEY=
SEC_EDGAR_MCP_URL=http://localhost:9870
# SEC requires a real name and contact address on every automated request.
# https://www.sec.gov/os/webmaster-faq#developers — replace before use.
SEC_EDGAR_USER_AGENT=YourName FinVet (your.real@email.com)

# --- PostgreSQL (matches docker-compose defaults) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=finvet
POSTGRES_PASSWORD=
POSTGRES_DB=finvet

# --- Guardrails ---
# Regex guard always runs. Llama Guard adds a semantic layer and needs Ollama:
#   docker compose --profile guards up -d
#   docker exec finvet-ollama ollama pull llama-guard3:8b
ENABLE_LLAMA_GUARD=false
LLAMA_GUARD_URL=http://localhost:11434
LLAMA_GUARD_MODEL=llama-guard3:8b

# --- Experimental features (off by default) ---
# Claim memory searches past verifications to offer a cached result or prior
# context. Its output is prior *model* output, not a source, so it ships
# disabled -- see docs/RELEASE_A_DECISIONS.md, D8. Turning it on needs Ollama
# for embeddings; with it off, /memory-check simply returns no matches.
ENABLE_CLAIM_MEMORY=false

# --- Application ---
LOG_LEVEL=INFO
ENABLE_NEWS_AGENT=true

# --- Optional tracing ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=finvet

# Optional: external evaluation dataset for the benchmark harnesses and
# conformance tests (not distributed with FinVet; tests skip without it)
FINVET_EVAL_DATA_DIR=
